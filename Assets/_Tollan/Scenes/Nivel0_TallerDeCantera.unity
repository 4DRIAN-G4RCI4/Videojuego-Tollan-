  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8fec7379808dd704aa4668898158e732, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  lines:
  - speaker: Ixtli
    text: "\xBFQu\xE9...? La piedra... est\xE1 respirando."
  - speaker: Atlante
    text: "...Hija de la cantera. Mi sue\xF1o se rompi\xF3... y con \xE9l despert\xF3
      Tezcatl."
  - speaker: Atlante
    text: "Devora la memoria del valle. Mi poder est\xE1 partido en cuatro Corazones
      de Obsidiana."
  - speaker: Atlante
    text: Toma el Pico de Tollan. Rompe la piedra que te cierra el paso.
  - speaker: Tezcatl
    text: "...Por fin libre. El valle olvidar\xE1 a sus muertos... y t\xFA tambi\xE9n,
      ni\xF1a."
  - speaker: Ixtli
    text: "\xA1\xBFQu\xE9 fue eso?!  ...Abuelo, \xBFest\xE1s viendo esto?"
  autoStart: 0
  oneShot: 1
  grantsPico: 1
  promptIcon: {fileID: 484067004}
  wakeAnimator: {fileID: 528941916}
  wakeState: idle
  unlocksSwitch: 0
  activateOnFinish: {fileID: 268093622}
  deactivateOnFinish: {fileID: 0}

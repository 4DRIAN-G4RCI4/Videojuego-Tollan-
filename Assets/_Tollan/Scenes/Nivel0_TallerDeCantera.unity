  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8fec7379808dd704aa4668898158e732, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  lines:
  - speaker: Abuelo Nabor
    text: Ixtli, ya es tarde... termina de limpiar la base del Atlante y nos vamos
      a casa.
  - speaker: Abuelo Nabor
    text: "F\xEDjate en los letreros de arriba: te dicen c\xF3mo moverte y qu\xE9
      hace cada cosa."
  - speaker: Abuelo Nabor
    text: Y ojo con los huecos de la cantera, mija. Las estelas cuentan cosas del
      pasado.
  - speaker: Ixtli
    text: "S\xED, abuelo. Ahorita voy."
  autoStart: 1
  oneShot: 1
  grantsPico: 0
  promptIcon: {fileID: 0}
  wakeAnimator: {fileID: 0}
  wakeState: idle
  unlocksSwitch: 0
  activateOnFinish: {fileID: 0}
  deactivateOnFinish: {fileID: 0}

  m_Script: {fileID: 11500000, guid: 8fec7379808dd704aa4668898158e732, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  lines:
  - speaker: "Itzc\xF3atl"
    text: "\xA1Ixtli! Se oy\xF3 un estruendo en todo el taller... \xBFqu\xE9 pas\xF3?"
  - speaker: Ixtli
    text: "El Atlante despert\xF3. Y algo oscuro sali\xF3 de la piedra: Tezcatl.
      Se lleva la memoria del valle."
  - speaker: "Itzc\xF3atl"
    text: Entonces no vas sola. Traje la pala de la cantera.
  - speaker: Ixtli
    text: Vamos. El Atlante dijo que hay que ir a los cuatro rumbos.
  autoStart: 1
  oneShot: 1
  grantsPico: 0
  promptIcon: {fileID: 0}
  wakeAnimator: {fileID: 0}
  wakeState: idle
  unlocksSwitch: 1
